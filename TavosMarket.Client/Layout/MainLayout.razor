@using TavosMarket.Client.Theme
@inherits LayoutComponentBase

<MudThemeProvider Theme="TavosMarketTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIcon Icon="@Icons.Material.Filled.LocalMall" Color="Color.Inherit" Class="ml-3" />
        <MudText Typo="Typo.h6" Class="ml-2" Style="letter-spacing: 1px; font-weight: 800;">TAVOS</MudText>
        <NavMenu />
        <MudSpacer />
        <LoginDisplay />
    </MudAppBar>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>