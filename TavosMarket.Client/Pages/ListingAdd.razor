@page "/listings/add"
@page "/listings/edit/{Id:guid}"
@using TavosMarket.Shared.Listings.DTOs
@using TavosMarket.Shared.Categories.DTOs
@using TavosMarket.Shared
@using TavosMarket.Client.Components
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    @if (Id is not null)
    {
        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Href=@($"/listings/details/{Id}?returnUrl={BackPage}")
                   Class="mb-4">
            Back to Details
        </MudButton>
    }
    else
    {
        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Href=@BackPage
                   Class="mb-4">
            Back to Listings
        </MudButton>
    }
    <MudPaper Class="pa-6">
        <MudText Typo="Typo.h4" Class="mb-6">@(IsEdit ? "Edit Listing" : "New Listing")</MudText>

        @if (_initializing)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
        }
        else
        {
            <MudForm @ref="_form" @bind-IsValid="@_success">
                <MudGrid>
                    <MudItem xs="12">
                        <MudSelect T="Guid?" Label="Category" Value="@_listing.CategoryId" ValueChanged="OnCategoryChanged" Required="true" RequiredError="Select a category" Disabled="IsEdit">
                            <MudSelectItem T="Guid?" Value="null">Select Category</MudSelectItem>
                            @foreach (var cat in _categories)
                            {
                                <MudSelectItem T="Guid?" Value="@cat.Id">@cat.Name</MudSelectItem>
                                @if (cat.Children.Any())
                                {
                                    @foreach (var sub in cat.Children)
                                    {
                                        <MudSelectItem T="Guid?" Value="@sub.Id">-- @sub.Name</MudSelectItem>
                                    }
                                }
                            }
                        </MudSelect>
                    </MudItem>

                    @if (_listing.CategoryId != Guid.Empty)
                    {
                        <MudItem xs="12">
                            <MudTextField T="string" Label="Title" @bind-Value="_listing.Title" Required="true"/>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudNumericField T="decimal" Label="Price" @bind-Value="_listing.Price" Required="true" AdornmentText="€" Adornment="Adornment.End"/>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudCheckBox T="bool" Label="Price Negotiable" @bind-Value="_listing.IsNegotiable" Color="Color.Primary"/>
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField T="string" Label="Description" @bind-Value="_listing.Description" Lines="5" Required="true"/>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="City" @bind-Value="_listing.City" Required="true"/>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="Region" @bind-Value="_listing.Region"/>
                        </MudItem>

                        <MudItem xs="12">
                            <MudDivider Class="my-4"/>
                            <MudText Typo="Typo.h6" Class="mb-2">Specifications</MudText>
                        </MudItem>

                        @foreach (var fv in _listing.FieldValues)
                        {
                            <DynamicFieldEditor Field="fv.FieldDefinition" Value="fv"/>
                        }

                        <MudItem xs="12">
                            <MudDivider Class="my-4"/>
                            <MudText Typo="Typo.h6" Class="mb-2">Images</MudText>

                            <div class="d-flex flex-wrap gap-4 mb-4">
                                @foreach (var img in _listing.Images)
                                {
                                    <div style="position: relative;">
                                        <MudImage Src="@GetImagePreviewUrl(img)" Width="100" Height="100" ObjectFit="ObjectFit.Cover" Class="rounded shadow-sm"/>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       Style="position: absolute; top: 0; right: 0; background: rgba(255,255,255,0.7);"
                                                       OnClick="@(() => RemoveImage(img))"/>
                                        @if (img.IsMain)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Style="position: absolute; bottom: 0; left: 0;">Main</MudChip>
                                        }
                                        else
                                        {
                                            <MudButton Size="Size.Small" OnClick="@(() => SetMainImage(img))" Style="position: absolute; bottom: 0; left: 0; background: rgba(255,255,255,0.7);">Set Main</MudButton>
                                        }
                                    </div>
                                }
                            </div>

                            <MudFileUpload @ref="_fileUploadRef" T="IReadOnlyList<IBrowserFile>" FilesChanged="UploadFiles" AppendMultipleFiles>
                                <CustomContent>
                                    <MudButton OnClick="@(() => _fileUploadRef.OpenFilePickerAsync())" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload">
                                        Upload Images
                                    </MudButton>
                                </CustomContent>
                            </MudFileUpload>
                        </MudItem>

                        <MudItem xs="12" Class="d-flex justify-end mt-6">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Disabled="@(!_success || _loading)" Loading="@_loading">
                                @(IsEdit ? "Update" : "Publish")
                            </MudButton>
                        </MudItem>
                    }
                </MudGrid>
            </MudForm>
        }
    </MudPaper>
</MudContainer>

@code {
    [Parameter] public Guid? Id { get; set; }
    private bool IsEdit => Id.HasValue;
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? BackPage { get; set; }
    
    private MudForm _form = null!;
    private bool _success;
    private bool _loading;
    private bool _initializing = true;
    private List<CategoryDto> _categories = new();
    private ListingDto _listing = new() { CategoryId = Guid.Empty };
    private MudFileUpload<IReadOnlyList<IBrowserFile>> _fileUploadRef = null!;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _initializing = true;
        try
        {
            await LoadCategories();
            if (IsEdit)
            {
                var client = HttpClientFactory.CreateClient("Api");
                var url = ApiRoutes.Listings.GetById.Replace("{id}", Id.ToString());
                var listing = await client.GetFromJsonAsync<ListingDto>(url);
                if (listing != null)
                {
                    _listing = listing;
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error loading data: " + ex.Message, Severity.Error);
        }
        finally
        {
            _initializing = false;
        }
    }

    private async Task LoadCategories()
    {
        var client = HttpClientFactory.CreateClient("Api");
        _categories = await client.GetFromJsonAsync<List<CategoryDto>>(ApiRoutes.Categories.Base) ?? new();
    }

    private async Task OnCategoryChanged(Guid? categoryId)
    {
        if (categoryId == null || categoryId == Guid.Empty)
        {
            _listing.CategoryId = Guid.Empty;
            _listing.FieldValues.Clear();
            return;
        }

        _listing.CategoryId = categoryId.Value;
        await LoadCategoryFields(categoryId.Value);
    }

    private async Task LoadCategoryFields(Guid categoryId)
    {
        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            var url = ApiRoutes.Categories.GetById.Replace("{id}", categoryId.ToString());
            var category = await client.GetFromJsonAsync<CategoryDto>(url);

            if (category != null)
            {
                _listing.FieldValues = category.FieldDefinitions.Select(fd => new ListingFieldValueDto
                {
                    FieldDefinitionId = fd.Id,
                    FieldDefinition = fd
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error loading category fields: " + ex.Message, Severity.Error);
        }
    }

    private async Task UploadFiles(IReadOnlyList<IBrowserFile>? files)
    {
        if (files == null) return;

        foreach (var file in files)
        {
            try
            {
                var buffer = new byte[file.Size];
                await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).ReadAsync(buffer);

                _listing.Images.Add(new ListingImageDto
                {
                    FileName = file.Name,
                    Data = buffer,
                    IsMain = !_listing.Images.Any(),
                    SortOrder = _listing.Images.Count
                });
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error processing {file.Name}: {ex.Message}", Severity.Error);
            }
        }
    }

    private string GetImagePreviewUrl(ListingImageDto img)
    {
        if (!string.IsNullOrEmpty(img.Url))
        {
            if (img.Url.StartsWith("http")) return img.Url;
            var client = HttpClientFactory.CreateClient("Api");
            return $"{client.BaseAddress?.ToString().TrimEnd('/')}{img.Url}";
        }
        
        if (img.Data != null)
        {
            return $"data:image/jpeg;base64,{Convert.ToBase64String(img.Data)}";
        }
        
        return "/images/no-image.png";
    }

    private void RemoveImage(ListingImageDto img)
    {
        _listing.Images.Remove(img);
        if (img.IsMain && _listing.Images.Any())
        {
            _listing.Images.First().IsMain = true;
        }
    }

    private void SetMainImage(ListingImageDto img)
    {
        foreach (var i in _listing.Images) i.IsMain = false;
        img.IsMain = true;
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _loading = true;
        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            HttpResponseMessage response;

            if (IsEdit)
            {
                var url = ApiRoutes.Listings.Update.Replace("{id}", Id.ToString());
                response = await client.PutAsJsonAsync(url, _listing);
            }
            else
            {
                response = await client.PostAsJsonAsync(ApiRoutes.Listings.Create, _listing);
            }

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(IsEdit ? "Listing updated successfully!" : "Listing published successfully!", Severity.Success);
                NavigationManager.NavigateTo("/listings");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add("Error: " + error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error: " + ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
