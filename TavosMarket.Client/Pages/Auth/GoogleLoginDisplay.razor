@using TavosMarket.Client.Auth
@using TavosMarket.Shared
@using TavosMarket.Shared.Auth.DTOs
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IHttpClientFactory HttpClientFactory;
@inject NavigationManager Navigation;
@inject ISnackbar Snackbar;
@inject IJSRuntime JsRuntime
@inject IConfiguration Configuration

<div id="googleBtn" class="mt-4"></div>

@code {
    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public EventCallback<bool> IsBusyChanged { get; set; }
    private DotNetObjectReference<GoogleLoginDisplay>? _objRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _objRef = DotNetObjectReference.Create(this);
            await JsRuntime.InvokeVoidAsync("initializeGoogleSignIn", _objRef, Configuration["Google:ClientId"]);
        }
    }

    [JSInvokable]
    public async Task HandleGoogleSignIn(string token)
    {
        try
        {
            await IsBusyChanged.InvokeAsync(true);
            StateHasChanged();

            var request = new GoogleLoginRequest(token);
            var api = HttpClientFactory.CreateClient("Api");
            var response = await api.PostAsJsonAsync(ApiRoutes.Auth.GoogleLogin, request);

            if (!response.IsSuccessStatusCode)
            {
                var errorResponse = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                Snackbar.Add(errorResponse?.Error ?? "Google login failed.", Severity.Error);
                return;
            }

            var authResponse = await response.Content.ReadFromJsonAsync<AuthResponse>();
            if (authResponse is null)
            {
                Snackbar.Add("Login response is empty.", Severity.Error);
                return;
            }

            if (AuthenticationStateProvider is TokenAuthenticationStateProvider tokenProvider)
                await tokenProvider.SetTokenAsync(authResponse.AccessToken);

            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            await IsBusyChanged.InvokeAsync(false);
            StateHasChanged();
        }
    }
}