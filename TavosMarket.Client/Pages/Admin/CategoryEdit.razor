@page "/admin/categories/create"
@page "/admin/categories/edit/{Id:guid}"
@using Microsoft.AspNetCore.Authorization
@using TavosMarket.Shared.Categories.DTOs
@using TavosMarket.Shared.Enums
@using TavosMarket.Shared

@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

@attribute [Authorize(Roles = "Admin")]
<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudButton Variant="Variant.Text" 
               Color="Color.Primary" 
               StartIcon="@Icons.Material.Filled.ArrowBack" 
               Href="/admin/categories" 
               Class="mb-4">
        Back to Categories
    </MudButton>
    <MudText Typo="Typo.h4" Class="mb-4">@(IsEdit ? "Edit Category" : "New Category")</MudText>

    @if (_loading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" md="5">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudForm @ref="_form" @bind-IsValid="@_success">
                        <MudTextField Variant="Variant.Outlined" Label="Name" @bind-Value="_category.Name" Required="true" RequiredError="Name is required"/>
                        <MudTextField Variant="Variant.Outlined" Label="Description" @bind-Value="_category.Description" Lines="3"/>

                        <MudSelect T="Guid?" Variant="Variant.Outlined" Label="Parent Category" @bind-Value="_category.ParentId" AnchorOrigin="Origin.BottomCenter" Class="mt-2">
                            <MudSelectItem T="Guid?" Value="null">None (Root)</MudSelectItem>
                            @foreach (var cat in _allCategories.Where(c => c.Id != _category.Id))
                            {
                                <MudSelectItem T="Guid?" Value="@cat.Id">@cat.Name</MudSelectItem>
                            }
                        </MudSelect>

                        <MudNumericField Variant="Variant.Outlined" T="int" Label="Sort Order" @bind-Value="_category.SortOrder" Class="mt-2"/>
                        <MudSwitch T="bool" Label="Active" @bind-Value="_category.IsActive" Color="Color.Primary" Class="mt-2"/>
                        <MudSwitch T="bool" Label="Direct use for listings" @bind-Value="_category.IsDirectUseForListings" Color="Color.Info" Class="mt-2"/>
                    </MudForm>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="7">
                <MudPaper Class="pa-4" Elevation="2">
                    <div class="d-flex justify-space-between align-center mb-4">
                        <MudText Typo="Typo.h6">Field Configurator</MudText>
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" Color="Color.Primary" OnClick="AddField">
                            Add Field
                        </MudButton>
                    </div>

                    @if (_category.FieldDefinitions.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info">No fields added yet. Click "Add Field" to configure characteristics for this category.</MudAlert>
                    }
                    else
                    {
                        <MudTable Items="@_category.FieldDefinitions" Hover="true" Elevation="0" Dense="true">
                            <HeaderContent>
                                <MudTh>Order</MudTh>
                                <MudTh>Name</MudTh>
                                <MudTh>Type</MudTh>
                                <MudTh Style="width: 100px;">Actions</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.SortOrder</MudTd>
                                <MudTd>
                                    <MudText Typo="Typo.body1">@context.Name</MudText>
                                </MudTd>
                                <MudTd>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">@context.DataTypeDto</MudChip>
                                </MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditField(context))"/>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => RemoveField(context))"/>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-end mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Default" OnClick="Cancel" Class="mr-2">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@(!_success)">Save Category</MudButton>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    [Parameter] public Guid? Id { get; set; }
    
    private CategoryDto _category = new() { FieldDefinitions = new() };
    private List<CategoryDto> _allCategories = new();
    private bool IsEdit => Id.HasValue;
    private bool _loading = true;
    private bool _success;
    private MudForm _form = null!;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            var tree = await client.GetFromJsonAsync<List<CategoryDto>>(ApiRoutes.Categories.Base) ?? new();
            _allCategories = FlattenCategories(tree);
            
            if (IsEdit)
            {
                _category = await client.GetFromJsonAsync<CategoryDto>($"{ApiRoutes.Categories.Base}/{Id}") ?? new();
            }
            else
            {
                _category = new CategoryDto { IsActive = true, FieldDefinitions = new() };
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error loading data: " + ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private List<CategoryDto> FlattenCategories(List<CategoryDto> categories, string prefix = "")
    {
        var result = new List<CategoryDto>();
        foreach (var cat in categories)
        {
            var flatCat = new CategoryDto 
            { 
                Id = cat.Id, 
                Name = prefix + cat.Name,
                FullName = cat.FullName,
                IsDirectUseForListings = cat.IsDirectUseForListings
            };
            result.Add(flatCat);
            if (cat.Children.Any())
            {
                result.AddRange(FlattenCategories(cat.Children, prefix + "— "));
            }
        }
        return result;
    }

    private async Task AddField()
    {
        var newField = new CategoryFieldDefinitionDto 
        { 
            SortOrder = _category.FieldDefinitions.Count + 1,
            DataTypeDto = FieldDataTypeDto.Text
        };
        
        var parameters = new DialogParameters { ["Field"] = newField, ["Title"] = "New Field" };
        var dialog = await DialogService.ShowAsync<FieldEditorDialog>("Field Settings", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: CategoryFieldDefinitionDto field })
        {
            _category.FieldDefinitions.Add(field);
            _success = true;
            StateHasChanged();
        }
    }

    private async Task EditField(CategoryFieldDefinitionDto field)
    {
        // Create copy for editing
        var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
        var fieldCopy = System.Text.Json.JsonSerializer.Deserialize<CategoryFieldDefinitionDto>(
            System.Text.Json.JsonSerializer.Serialize(field, options), options)!;
        
        var parameters = new DialogParameters { ["Field"] = fieldCopy, ["Title"] = "Edit Field" };
        var dialog = await DialogService.ShowAsync<FieldEditorDialog>("Field Settings", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: CategoryFieldDefinitionDto updatedField })
        {
            var index = _category.FieldDefinitions.FindIndex(f => f.Id == field.Id);
            _category.FieldDefinitions[index] = updatedField;
            _success = true;
            StateHasChanged();
        }
    }

    private void RemoveField(CategoryFieldDefinitionDto field)
    {
        _success = true;
        _category.FieldDefinitions.Remove(field);
    }

    private async Task Save()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            HttpResponseMessage response;
            if (IsEdit)
            {
                var url = ApiRoutes.Categories.AdminById.Replace("{id}", Id.ToString());
                response = await client.PutAsJsonAsync(url, _category);
            }
            else
            {
                response = await client.PostAsJsonAsync(ApiRoutes.Categories.Admin, _category);
            }

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Category saved", Severity.Success);
                NavigationManager.NavigateTo("/admin/categories");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add("Error saving: " + error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error: " + ex.Message, Severity.Error);
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/admin/categories");
    }
}
