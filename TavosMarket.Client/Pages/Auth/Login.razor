@page "/login"
@using System.ComponentModel.DataAnnotations
@using TavosMarket.Client.Auth
@using TavosMarket.Shared
@using TavosMarket.Shared.Auth.DTOs

@implements IDisposable
@inject IHttpClientFactory HttpClientFactory;
@inject NavigationManager Navigation;
@inject ISnackbar Snackbar;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JsRuntime

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-10">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5">Login</MudText>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent>
            <MudForm @ref="@_form">
                <MudStack Spacing="2">
                    <MudTextField @bind-Value="_model.Email"
                                  Label="Email"
                                  Variant="Variant.Outlined"
                                  For="() => _model.Email" />

                    <MudTextField @bind-Value="_model.Password"
                                  Label="Password"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  For="() => _model.Password" />

                    <MudCheckBox @bind-Value="_model.RememberPassword"
                                 Label="Remember password"
                                 Color="Color.Primary" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               OnClick="HandleLogin"
                               Disabled="_isBusy">
                        Login
                    </MudButton>

                    <GoogleLoginDisplay IsBusy="_isBusy"
                                        IsBusyChanged="@(value => _isBusy = value)" />
                    
                    <MudText Typo="Typo.body2" Align="Align.Center">
                        Don't have an account?
                        <MudLink Href="/register" Underline="Underline.Hover">
                            Register here
                        </MudLink>
                    </MudText>
                </MudStack>
            </MudForm>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private const string RememberPasswordKey = "loginRememberPassword";
    private const string RememberedEmailKey = "loginEmail";
    private const string RememberedPasswordKey = "loginPassword";

    private readonly LoginVm _model = new();
    private bool _isBusy;
    private MudForm _form = null!;
    private DotNetObjectReference<Login>? _objRef;

    protected override async Task OnInitializedAsync()
    {
        var rememberPassword = await JsRuntime.InvokeAsync<string?>("localStorage.getItem", RememberPasswordKey);

        if (rememberPassword != "true")
            return;

        _model.RememberPassword = true;
        _model.Email = await JsRuntime.InvokeAsync<string?>("localStorage.getItem", RememberedEmailKey) ?? string.Empty;
        _model.Password = await JsRuntime.InvokeAsync<string?>("localStorage.getItem", RememberedPasswordKey) ?? string.Empty;
    }

    private async Task HandleLogin()
    {
        await _form.ValidateAsync();

        if (!_form.IsValid)
            return;

        try
        {
            _isBusy = true;

            var request = new LoginRequest(_model.Email, _model.Password);

            var api = HttpClientFactory.CreateClient("Api");
            var response = await api.PostAsJsonAsync(ApiRoutes.Auth.Login, request);

            if (!response.IsSuccessStatusCode)
            {
                var errorResponse = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                Snackbar.Add(errorResponse?.Error ?? "Invalid email or password.", Severity.Error);
                return;
            }

            var authResponse = await response.Content.ReadFromJsonAsync<AuthResponse>();
            if (authResponse is null)
            {
                Snackbar.Add("Login response is empty.", Severity.Error);
                return;
            }

            if (_model.RememberPassword)
            {
                await JsRuntime.InvokeVoidAsync("localStorage.setItem", RememberPasswordKey, "true");
                await JsRuntime.InvokeVoidAsync("localStorage.setItem", RememberedEmailKey, _model.Email);
                await JsRuntime.InvokeVoidAsync("localStorage.setItem", RememberedPasswordKey, _model.Password);
            }
            else
            {
                await JsRuntime.InvokeVoidAsync("localStorage.removeItem", RememberPasswordKey);
                await JsRuntime.InvokeVoidAsync("localStorage.removeItem", RememberedEmailKey);
                await JsRuntime.InvokeVoidAsync("localStorage.removeItem", RememberedPasswordKey);
            }

            if (AuthenticationStateProvider is TokenAuthenticationStateProvider tokenProvider)
                await tokenProvider.SetTokenAsync(authResponse.AccessToken);
            
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            if (authState.User.Identity?.IsAuthenticated == true && authState.User.IsInRole("Admin"))
            {
                Navigation.NavigateTo("/admin/dashboard");
                return;
            }

            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private sealed class LoginVm
    {
        [Required]
        public string Email { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;

        public bool RememberPassword { get; set; }
    }

    public void Dispose() => _objRef?.Dispose();
}