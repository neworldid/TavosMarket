@page "/register"
@using System.ComponentModel.DataAnnotations
@using TavosMarket.Client.Auth
@using TavosMarket.Shared
@using TavosMarket.Shared.Auth.DTOs

@inject IHttpClientFactory HttpClientFactory;
@inject ISnackbar Snackbar;
@inject NavigationManager Navigation;
@inject AuthenticationStateProvider AuthenticationStateProvider;

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-10">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5">Register</MudText>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent>
            <MudForm @ref="_form">
                <MudStack Spacing="2">
                    <MudTextField @bind-Value="_model.Email"
                                  Label="Email"
                                  Variant="Variant.Outlined"
                                  For="() => _model.Email"/>

                    <MudTextField @bind-Value="_model.UserName"
                                  Label="User name"
                                  Variant="Variant.Outlined"
                                  For="() => _model.UserName"/>

                    <MudTextField @bind-Value="_model.FirstName"
                                  Label="First name"
                                  Variant="Variant.Outlined"
                                  For="() => _model.FirstName"/>

                    <MudTextField @bind-Value="_model.LastName"
                                  Label="Last name"
                                  Variant="Variant.Outlined"
                                  For="() => _model.LastName"/>

                    <MudTextField @bind-Value="_model.Password"
                                  Label="Password"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  For="() => _model.Password" />

                    <MudButton ButtonType="ButtonType.Button"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               OnClick="@HandleRegister"
                               Disabled="@_isBusy">
                        Register
                    </MudButton>
                    
                    <GoogleLoginDisplay IsBusy="_isBusy"
                                        IsBusyChanged="@(value => _isBusy = value)" />
                    
                    <MudText Typo="Typo.body2" Align="Align.Center">
                        Already have an account?
                        <MudLink Href="/login" Underline="Underline.Hover">
                            Login here
                        </MudLink>
                    </MudText>
                </MudStack>
            </MudForm>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private MudForm _form = null!;
    private bool _isBusy;
    private readonly RegisterVm _model = new();

    private async Task HandleRegister()
    {
        await _form.ValidateAsync();

        if (!_form.IsValid)
            return;

        try
        {
            _isBusy = true;

            var request = new RegisterRequest(
                _model.Email,
                _model.Password,
                _model.UserName,
                _model.FirstName,
                _model.LastName);

            var api = HttpClientFactory.CreateClient("Api");
            var response = await api.PostAsJsonAsync(ApiRoutes.Auth.Register, request);
            
            if (!response.IsSuccessStatusCode)
            {
                var errorResponse = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                Snackbar.Add(errorResponse?.Error ?? "Registration failed.", Severity.Error);
                return;
            }

            var authResponse = await response.Content.ReadFromJsonAsync<AuthResponse>();
            if (authResponse is null)
                return;

            if (AuthenticationStateProvider is TokenAuthenticationStateProvider tokenProvider)
                await tokenProvider.SetTokenAsync(authResponse.AccessToken);

            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private sealed class RegisterVm
    {
        public string Email { get; set; } = string.Empty;
        [Required]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters long.")]
        [RegularExpression(@"^(?=.*[A-Z])(?=.*[^a-zA-Z0-9]).+$",
            ErrorMessage = "Password must contain at least one uppercase letter and one special character.")]
        public string Password { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
        public string? FirstName { get; set; }
        public string? LastName { get; set; }
    }
}