@using System.Security.Claims
@using TavosMarket.Client.Auth
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<AuthorizeView>
    <Authorized>
        <MudStack Row="true" AlignItems="AlignItems.Center">
            @if (context.User.Identity?.Name != null)
            {

                var firstName = context.User.FindFirst(ClaimTypes.GivenName)?.Value;
                var lastName = context.User.FindFirst(ClaimTypes.Surname)?.Value;
                var userName = context.User.Identity?.Name;

                <MudText Typo="Typo.subtitle1">
                    @if (firstName != null && lastName != null)
                    {
                        @($"{firstName} {lastName}")
                    }
                    else
                    {
                        @userName
                    }
                </MudText>
            }
            <MudButton
                Variant="Variant.Text"
                StartIcon="@Icons.Material.Filled.Logout"
                OnClick="@Logout"
                Color="Color.Inherit"
                Class="nav-button-item">
                Logout
            </MudButton>
        </MudStack>
    </Authorized>
    <NotAuthorized>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudButton
                Variant="Variant.Text"
                StartIcon="@Icons.Material.Filled.Login"
                OnClick="@Login"
                Color="Color.Inherit"
                Class="nav-button-item">
                Login
            </MudButton>
        </MudStack>
    </NotAuthorized>
</AuthorizeView>

<style>
    .nav-button-item {
        color: rgba(255,255,255,0.85) !important;
        border-radius: 8px !important;
        padding: 8px 16px !important;
        text-transform: none !important;
        transition: all 0.2s;
    }
    .nav-button-item:hover {
        background-color: rgba(255, 255, 255, 0.1) !important;
        color: white !important;
    }
</style>

@code {

    private void Login()
    {
        Navigation.NavigateTo("/login");
    }

    private async Task Logout()
    {
        if (AuthenticationStateProvider is TokenAuthenticationStateProvider tokenProvider)
            await tokenProvider.ClearTokenAsync();

        Navigation.NavigateTo("/login");
    }

}
