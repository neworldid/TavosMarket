@using TavosMarket.Shared.Enums
@using TavosMarket.Shared.Listings.DTOs
@using TavosMarket.Shared.Categories.DTOs

<MudItem xs="12" md="6">
    @switch (Field.DataTypeDto)
    {
        case FieldDataTypeDto.Text:
            <MudTextField Variant="Variant.Outlined"
                          Label="@Field.Name" 
                          @bind-Value="Value.StringValue" 
                          Required="@Field.IsRequired" 
                          Placeholder="@Field.Placeholder" 
                          AdornmentText="@Field.Unit" 
                          Adornment="Adornment.End" />
            break;

        case FieldDataTypeDto.MultilineText:
            <MudTextField Variant="Variant.Outlined"
                          Label="@Field.Name" 
                          @bind-Value="Value.StringValue" 
                          Required="@Field.IsRequired" 
                          Placeholder="@Field.Placeholder" 
                          Lines="3" />
            break;

        case FieldDataTypeDto.Integer:
            <MudNumericField Variant="Variant.Outlined"
                             Label="@Field.Name" 
                             @bind-Value="Value.IntValue" 
                             Required="@Field.IsRequired" 
                             Placeholder="@Field.Placeholder" 
                             AdornmentText="@Field.Unit" 
                             Adornment="Adornment.End" />
            break;

        case FieldDataTypeDto.Decimal:
            <MudNumericField Variant="Variant.Outlined"
                             Label="@Field.Name" 
                             @bind-Value="Value.DecimalValue" 
                             Required="@Field.IsRequired" 
                             Placeholder="@Field.Placeholder" 
                             AdornmentText="@Field.Unit" 
                             Adornment="Adornment.End" />
            break;

        case FieldDataTypeDto.Boolean:
            <MudCheckBox Variant="Variant.Outlined"
                         Label="@Field.Name" 
                         @bind-Value="Value.BoolValue" 
                         Color="Color.Primary" />
            break;

        case FieldDataTypeDto.Date:
        case FieldDataTypeDto.DateTime:
            <MudDatePicker Label="@Field.Name"
                           Variant="Variant.Outlined"
                           @bind-Date="DateValue" 
                           Required="@Field.IsRequired" 
                           Placeholder="@Field.Placeholder" />
            break;

        case FieldDataTypeDto.Select:
            <MudSelect T="Guid?"
                       Variant="Variant.Outlined"
                       Label="@Field.Name" 
                       @bind-Value="Value.OptionId" 
                       Required="@Field.IsRequired" 
                       AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem T="Guid?" Value="null">Select option...</MudSelectItem>
                @foreach (var opt in Field.Options.OrderBy(o => o.SortOrder))
                {
                    <MudSelectItem T="Guid?" Value="@opt.Id">@opt.Value</MudSelectItem>
                }
            </MudSelect>
            break;

        case FieldDataTypeDto.MultiSelect:
            <MudSelect T="Guid"
                       Variant="Variant.Outlined"
                       Label="@Field.Name" 
                       SelectedValues="SelectedOptions"
                       SelectedValuesChanged="OnOptionsChanged"
                       MultiSelection="true"
                       ToStringFunc="GetOptionText"
                       Required="@Field.IsRequired"
                       AnchorOrigin="Origin.BottomCenter">
                @foreach (var opt in Field.Options.OrderBy(o => o.SortOrder))
                {
                    <MudSelectItem T="Guid" Value="@opt.Id">@opt.Value</MudSelectItem>
                }
            </MudSelect>
            break;
        default:
            <MudText Color="Color.Error">Unsupported field type: @Field.DataTypeDto</MudText>
            break;
    }
</MudItem>

@code {
    [Parameter] public CategoryFieldDefinitionDto Field { get; set; } = null!;
    [Parameter] public ListingFieldValueDto Value { get; set; } = null!;

    private DateTime? DateValue
    {
        get => Value.DateValue;
        set => Value.DateValue = value;
    }

    private IReadOnlyCollection<Guid> SelectedOptions
    {
        get => Value.OptionIds;
        set => Value.OptionIds = value.ToList();
    }

    private string GetOptionText(Guid optionId)
    {
        return Field.Options.FirstOrDefault(o => o.Id == optionId)?.Value ?? optionId.ToString();
    }

    private void OnOptionsChanged(IEnumerable<Guid> values)
    {
        Value.OptionIds = values.ToList();
    }
}
