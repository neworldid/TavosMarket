@page "/my-listings"
@using TavosMarket.Shared.Listings.DTOs
@using TavosMarket.Shared
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6">
        <MudText Typo="Typo.h4">My Listings</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="NavigateToAddListing">
            Post a Listing
        </MudButton>
    </MudStack>

    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="mb-6">
        <MudTabPanel Text="Active" OnClick="@(() => SetStatus(ListingStatusDto.Published))" />
        <MudTabPanel Text="Drafts" OnClick="@(() => SetStatus(ListingStatusDto.Draft))" />
        <MudTabPanel Text="Expired" OnClick="@(() => SetStatus(ListingStatusDto.Expired))" />
    </MudTabs>

    <MudGrid>
        @if (_loading)
        {
            @for (int i = 0; i < 4; i++)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Elevation="2">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" />
                        <MudCardContent>
                            <MudSkeleton Width="80%" />
                            <MudSkeleton Width="40%" />
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        }
        else if (!_filteredListings.Any())
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="mt-4">
                    No listings found in this category.
                </MudAlert>
            </MudItem>
        }
        else
        {
            @foreach (var listing in _filteredListings)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Elevation="2" Class="h-100 hover-card">
                        <div style="position: relative;" @onclick="@(() => NavigateToDetails(listing.Id))">
                            <MudCardMedia Image="@GetListingImageUrl(listing)" Height="200" />
                            <div style="position: absolute; bottom: 8px; left: 8px;">
                                <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Filled">@listing.Price.ToString("N0") €</MudChip>
                            </div>
                            @if (listing.Status == ListingStatusDto.Expired)
                            {
                                <div style="position: absolute; top: 8px; right: 8px;">
                                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">Expired</MudChip>
                                </div>
                            }
                            else if (listing.Status == ListingStatusDto.Draft)
                            {
                                <div style="position: absolute; top: 8px; right: 8px;">
                                    <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Filled">Draft</MudChip>
                                </div>
                            }
                        </div>
                        <MudCardContent @onclick="@(() => NavigateToDetails(listing.Id))">
                            <MudText Typo="Typo.subtitle1" Class="text-truncate"><b>@listing.Title</b></MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">@listing.Category?.Name</MudText>
                            @if (listing.ExpiresAt.HasValue)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1">
                                    @(listing.Status == ListingStatusDto.Expired ? "Expired on" : "Expires on"): @listing.ExpiresAt.Value.ToLocalTime().ToString("g")
                                </MudText>
                            }
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@(listing.City == null ? "City not specified" : listing.City.Name)</MudText>
                            </MudStack>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="@(() => EditListing(listing.Id))">Edit</MudButton>
                            <MudSpacer />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteListing(listing.Id))" />
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        }
    </MudGrid>
</MudContainer>

<style>
    .hover-card {
        transition: transform 0.2s;
        cursor: pointer;
    }
    .hover-card:hover {
        transform: translateY(-4px);
    }
    .text-truncate {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
</style>

@code {
    private List<ListingDto> _listings = new();
    private List<ListingDto> _filteredListings = new();
    private bool _loading = true;
    private ListingStatusDto _currentStatus = ListingStatusDto.Published;

    protected override async Task OnInitializedAsync()
    {
        await LoadMyListings();
    }

    private void SetStatus(ListingStatusDto status)
    {
        _currentStatus = status;
        _filteredListings = _listings.Where(l => l.Status == _currentStatus).ToList();
    }
    
    private string GetListingImageUrl(ListingDto listing)
    {
        var url = listing.Images.FirstOrDefault(i => i.IsMain)?.Url
               ?? listing.Images.FirstOrDefault()?.Url;

        if (string.IsNullOrEmpty(url)) return "/images/no-image.png";

        if (url.StartsWith("http")) return url;

        var client = HttpClientFactory.CreateClient("Api");
        return $"{client.BaseAddress?.ToString().TrimEnd('/')}{url}";
    }

    private async Task LoadMyListings()
    {
        _loading = true;
        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            _listings = await client.GetFromJsonAsync<List<ListingDto>>(ApiRoutes.Listings.MyListings) ?? new();
            SetStatus(_currentStatus);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error loading your listings: " + ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void NavigateToAddListing()
    {
        NavigationManager.NavigateTo($"/listings/add?returnUrl={Uri.EscapeDataString("/my-listings")}");
    }

    private void NavigateToDetails(Guid id)
    {
        NavigationManager.NavigateTo($"/listings/details/{id}?returnUrl={Uri.EscapeDataString("/my-listings")}");
    }

    private void EditListing(Guid id)
    {
        NavigationManager.NavigateTo($"/listings/edit/{id}?returnUrl={Uri.EscapeDataString("/my-listings")}");
    }

    private async Task DeleteListing(Guid id)
    {
        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            var response = await client.DeleteAsync(ApiRoutes.Listings.Delete.Replace("{id}", id.ToString()));
            
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Listing deleted successfully", Severity.Success);
                await LoadMyListings();
            }
            else
            {
                Snackbar.Add("Error deleting listing", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error deleting listing: " + ex.Message, Severity.Error);
        }
    }
}
